# Copy to backend/.env and adjust. Never commit the real .env.

# Matches docker-compose.yml at the repo root.
CODEROOM_DATABASE_URL=postgresql+asyncpg://coderoom:coderoom@localhost:5432/coderoom

# Secret for the keyed hash of room codes (at least 32 characters). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Changing it makes every existing room code stop working.
CODEROOM_CODE_HASH_KEY=

# JSON list of frontend origins allowed to call the API.
CODEROOM_CORS_ORIGINS=["http://localhost:5173"]
